# ==========================================
# KidsPlay AI Studio • Environment Template
# ==========================================

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default AI Model (gemini-4-argon, gemini-3.8-flash, or instant synthesizer fallback)
GEMINI_MODEL=gemini-4-argon

# Server Host & Port
HOST=0.0.0.0
PORT=8899

# Default Spoken & UI Language (gu-IN for Gujarati, hi-IN for Hindi, en-US for English)
DEFAULT_LANGUAGE=gu-IN

# Storage Directory for Evolution Memory & Checkpoints
DATA_DIR=data

# Autonomous Engine Features
AUTORESUME_ENABLED=true
SELF_HEALING_ENABLED=true
